# Development defaults. Copy this file to .env; never commit the copy.
DATABASE_URL=postgresql+psycopg://fmlcore:fmlcore@localhost:5433/fmlcore
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
# Set true when HTTPS terminates in front of the API. In production this defaults to true.
COOKIE_SECURE=false
