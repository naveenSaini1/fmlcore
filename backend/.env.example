# Development defaults. Copy this file to .env; never commit the copy.
DATABASE_URL=postgresql+psycopg://fmlcore:fmlcore@localhost:5433/fmlcore
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
APP_ENV=development
# Set true when HTTPS terminates in front of the API. In production this defaults to true.
COOKIE_SECURE=false
# Comma-separated existing account emails allowed into the admin console.
# Example: ADMIN_EMAILS=owner@example.com
ADMIN_EMAILS=
# Google Identity Services: Web application client ID. Authorize your frontend
# origins in Google Cloud (e.g. http://localhost:3000). No client secret is used.
GOOGLE_CLIENT_ID=
# Reusable email delivery. Disabled until SMTP_HOST and SMTP_FROM_EMAIL are set.
# Use STARTTLS on 587 or ssl on 465; plain is only for a local test mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FMLCore
SMTP_SECURITY=starttls
EMAIL_OTP_SECRET=
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_MAX_PER_HOUR=10
EMAIL_OTP_EVERY_LOGIN=false
# Same Sky uses Gemini for private analysis and embeddings.
# Use a paid/billing-enabled project; do not use Gemini's unpaid quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_VERSION=gemini-embedding-001
GEMINI_PAID_SERVICE_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SAME_SKY_GEMINI_REQUEST_GAP_SECONDS=7
SAME_SKY_GROQ_REQUEST_GAP_SECONDS=2
SAME_SKY_HASH_SECRET=replace-with-a-separate-long-random-secret
SAME_SKY_EMBEDDING_DIMENSIONS=768
SAME_SKY_REQUIRED_POSTS=3
SAME_SKY_REQUIRED_CONFESSIONS=3
SAME_SKY_RETRY_MINUTES=1
SAME_SKY_JOB_POLL_SECONDS=2

# Set true when Same Sky runs in a separate container/service.
SAME_SKY_WORKER_MANAGED=false

# Optional browser notifications. Keep the private key out of Git.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
