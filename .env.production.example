# Copy to .env.production on the deployment host. Do not commit the copy.
POSTGRES_USER=fmlcore
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_DB=fmlcore
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_DAYS=14
# Public HTTPS origins for the app and separate owner-only admin console.
CORS_ORIGINS=https://app.example.com,https://admin.example.com
ADMIN_EMAILS=owner@example.com
# Same Sky sends opted-in entries to Gemini for analysis and embeddings.
GEMINI_API_KEY=replace-on-deployment-host
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_VERSION=gemini-embedding-001
GEMINI_PAID_SERVICE_CONFIRMED=false
GROQ_API_KEY=replace-on-deployment-host
GROQ_MODEL=openai/gpt-oss-20b
SAME_SKY_GEMINI_REQUEST_GAP_SECONDS=7
SAME_SKY_GROQ_REQUEST_GAP_SECONDS=2
SAME_SKY_HASH_SECRET=replace-with-a-separate-long-random-secret
SAME_SKY_EMBEDDING_DIMENSIONS=768
SAME_SKY_REQUIRED_POSTS=3
SAME_SKY_REQUIRED_CONFESSIONS=3
SAME_SKY_RETRY_MINUTES=1440
SAME_SKY_JOB_POLL_SECONDS=2
