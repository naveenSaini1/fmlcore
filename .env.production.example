# Copy to .env.production on the deployment host. Do not commit the copy.
POSTGRES_USER=fmlcore
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_DB=fmlcore
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_DAYS=14
# The public HTTPS origin that serves the Next.js web app.
CORS_ORIGINS=https://app.example.com
